# Render / Docker worker — set these in the service Environment tab.
# Do not commit real secrets.

# LiveKit (required — same project as FastAPI token issuer)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Models / speech
GOOGLE_API_KEY=
ASSEMBLYAI_API_KEY=

# Vectors (Qdrant Cloud)
VECTOR_BACKEND=qdrant
QDRANT_URL=https://YOUR_CLUSTER.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_TIMEOUT_SEC=60

# Query embeddings (no local TEI on Render)
EMBEDDING_PROVIDER=huggingface
HF_TOKEN=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG behavior
RERANK_ENABLED=false

# Optional: mirror pipeline events to your public FastAPI
# PIPELINE_EVENTS_TO_API=true
# HEALIA_API_URL=https://your-api.onrender.com
PIPELINE_EVENTS_TO_API=false
