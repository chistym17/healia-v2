# Render / Docker / LiveKit Cloud worker — set these in the service Environment tab.
# Do not commit real secrets.

# LiveKit (injected automatically on LiveKit Cloud Agents; set on self-host)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Voice (Gemini Realtime)
GOOGLE_API_KEY=
ASSEMBLYAI_API_KEY=

# Text LLM — supervisor + guidance (Groq OpenAI GPT-OSS)
GROQ_API_KEY=
SUPERVISOR_MODEL=openai/gpt-oss-20b
GUIDANCE_MODEL=openai/gpt-oss-20b
# SUPERVISOR_TIMEOUT_SEC=15
# GUIDANCE_TIMEOUT_SEC=20

# Vectors (Qdrant Cloud)
VECTOR_BACKEND=qdrant
QDRANT_URL=https://YOUR_CLUSTER.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_TIMEOUT_SEC=60

# Query embeddings (no local TEI on Render)
EMBEDDING_PROVIDER=huggingface
HF_TOKEN=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG behavior
RERANK_ENABLED=false

# Optional: mirror pipeline events to your public FastAPI
# PIPELINE_EVENTS_TO_API=true
# HEALIA_API_URL=https://your-api.onrender.com
PIPELINE_EVENTS_TO_API=false

# FastAPI: wake LiveKit agent on successful login/signup (default on)
# LIVEKIT_AGENT_WARM=true
