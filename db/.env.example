# Postgres (Supabase → Settings → Database → URI)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Auth (Supabase → Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
ENABLE_DOCS=true

# Cloudflare Turnstile secret (signup). Leave empty to skip verification in local/dev.
# Must pair with frontend VITE_TURNSTILE_SITE_KEY. Local always-pass test secret:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
